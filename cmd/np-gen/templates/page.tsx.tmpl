// {{.Title}} admin page — generated by np-gen. A Table + create/edit
// Dialog over the standard named-resource endpoints, optimistic-locking
// aware (ETag / If-Match via resourceApi), mirroring web/src/pages/Templates.tsx.
//
// MANUAL: register the page in the app router/nav and add the
// '{{.KebabPlural}}' SSE invalidation key in web/src/api.ts (see the np-gen
// checklist). The `{{.Pascal}}` type must exist in web/src/types.ts.
import { useState } from 'react'
import { useQuery } from '@tanstack/react-query'
import { resourceApi, APIError } from '../api'
import type { {{.Pascal}} } from '../types'
import { Button } from '@/components/ui/button'
import { Card, CardHeader, CardTitle, CardAction, CardContent } from '@/components/ui/card'
import { Table, TableHeader, TableBody, TableRow, TableHead, TableCell } from '@/components/ui/table'
import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog'
import { Input } from '@/components/ui/input'
import { Switch } from '@/components/ui/switch'
import { Label } from '@/components/ui/label'
import { Empty, Spinner, Field, FormError, SubmitRow, useSave, DeleteButton } from '@/components/kit'
import { t } from '../i18n'

const {{.Camel}}Api = resourceApi<{{.Pascal}}>('{{.KebabPlural}}')
const {{.Camel}}Inval: string[][] = [[...{{.Camel}}Api.queryKey]]

// 409/412 → standard conflict copy.
function conflictMessage(err: unknown): unknown {
  if (err instanceof APIError && (err.status === 409 || err.status === 412)) {
    return 'Konflikt — bitte neu laden.'
  }
  return err
}

export function {{.PascalPlural}}Page() {
  const { data, isLoading } = useQuery({ queryKey: {{.Camel}}Api.queryKey, queryFn: {{.Camel}}Api.list })
  const [editing, setEditing] = useState<{ name: string } | 'new' | null>(null)
  const remove = useSave<string>((name) => {{.Camel}}Api.remove(name), { invalidate: {{.Camel}}Inval })

  return (
    <Card>
      <CardHeader>
        <CardTitle>{{.Title}}</CardTitle>
        <CardAction><Button variant="default" size="sm" onClick={() => setEditing('new')}>+ {t('create')}</Button></CardAction>
      </CardHeader>
      <CardContent>
        {isLoading ? <Spinner /> : (data?.length ?? 0) === 0 ? <Empty text={t('empty')} /> : (
          <Table>
            <TableHeader>
              <TableRow>
                {[t('name'), 'Aktiv', 'Notizen', ''].map((h, i) => <TableHead key={i}>{h}</TableHead>)}
              </TableRow>
            </TableHeader>
            <TableBody>
              {data!.map((row) => (
                <TableRow key={row.name}>
                  <TableCell className="text-foreground font-medium">{row.name}</TableCell>
                  <TableCell className="text-xs text-muted-foreground">{row.enabled ? 'ja' : '—'}</TableCell>
                  <TableCell className="text-xs text-muted-foreground">{row.notes || '—'}</TableCell>
                  <TableCell className="text-right whitespace-nowrap">
                    <Button size="sm" variant="ghost" onClick={() => setEditing({ name: row.name })}>{t('edit')}</Button>
                    <DeleteButton onDelete={() => remove.mutate(row.name)} />
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        )}
        {editing && (
          <{{.Pascal}}Dialog name={editing === 'new' ? null : editing.name} onClose={() => setEditing(null)} />
        )}
      </CardContent>
    </Card>
  )
}

function {{.Pascal}}Dialog({ name, onClose }: { name: string | null; onClose: () => void }) {
  const isEdit = name !== null
  const { data: loaded, isLoading } = useQuery({
    queryKey: [...{{.Camel}}Api.queryKey, name],
    queryFn: () => {{.Camel}}Api.get(name!),
    enabled: isEdit,
  })

  const [draftName, setDraftName] = useState('')
  const [enabled, setEnabled] = useState(false)
  const [notes, setNotes] = useState('')
  const [ready, setReady] = useState(!isEdit)

  if (isEdit && loaded && !ready) {
    setDraftName(loaded.data.name)
    setEnabled(!!loaded.data.enabled)
    setNotes(loaded.data.notes ?? '')
    setReady(true)
  }

  const save = useSave<void>(async () => {
    const doc: {{.Pascal}} = {
      name: isEdit ? name! : draftName,
      enabled,
      ...(notes ? { notes } : {}),
    }
    if (isEdit) return {{.Camel}}Api.update(name!, doc, loaded!.etag)
    return {{.Camel}}Api.create(doc)
  }, { invalidate: {{.Camel}}Inval, onDone: onClose })

  return (
    <Dialog open onOpenChange={(o) => { if (!o) onClose() }}>
      <DialogContent className="max-w-2xl max-h-[90vh] overflow-y-auto">
        <DialogHeader><DialogTitle>{isEdit ? `${t('edit')}: ${name}` : `{{.Title}} — ${t('create')}`}</DialogTitle></DialogHeader>
        {isEdit && isLoading ? <Spinner /> : (
          <form onSubmit={(e) => { e.preventDefault(); save.mutate() }} className="space-y-4">
            <Field label={t('name')} required>
              <Input value={isEdit ? name! : draftName} disabled={isEdit}
                onChange={(e) => setDraftName(e.target.value)} placeholder="{{.Kebab}}-1" autoFocus={!isEdit} />
            </Field>
            <div className="pb-1.5">
              <Label className="cursor-pointer">
                <Switch checked={enabled} onCheckedChange={setEnabled} />
                <span className="text-sm text-foreground/90">Aktiv</span>
              </Label>
            </div>
            <Field label="Notizen">
              <Input value={notes} onChange={(e) => setNotes(e.target.value)} placeholder="…" />
            </Field>
            <FormError error={conflictMessage(save.error)} />
            <SubmitRow onCancel={onClose} saving={save.isPending} disabled={!(isEdit ? name : draftName)}
              label={isEdit ? t('save') : t('create')} />
          </form>
        )}
      </DialogContent>
    </Dialog>
  )
}
