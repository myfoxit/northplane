---
// Shared frame for the inline SVG diagrams: responsive, theme-aware (all
// colours come from Starlight's CSS variables, so light and dark both work),
// with an accessible title/description.
interface Props {
	title: string;
	description?: string;
	viewBox: string;
	maxWidth?: string;
}
const { title, description, viewBox, maxWidth = '900px' } = Astro.props;
const id = 'dg-' + title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<figure class="np-diagram" style={`max-width:${maxWidth}`}>
	<svg
		viewBox={viewBox}
		role="img"
		aria-labelledby={`${id}-t ${id}-d`}
		xmlns="http://www.w3.org/2000/svg"
		font-family="var(--sl-font-system, ui-sans-serif, system-ui, sans-serif)"
	>
		<title id={`${id}-t`}>{title}</title>
		<desc id={`${id}-d`}>{description}</desc>
		<defs>
			<marker id={`${id}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="var(--sl-color-gray-3)"></path>
			</marker>
			<marker id={`${id}-arrow-accent`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="var(--sl-color-accent)"></path>
			</marker>
		</defs>
		<slot />
	</svg>
	{description && <figcaption>{description}</figcaption>}
</figure>

<style>
	.np-diagram {
		margin: 1.5rem auto;
		width: 100%;
	}
	.np-diagram svg {
		width: 100%;
		height: auto;
		display: block;
	}
	.np-diagram figcaption {
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		margin-top: 0.5rem;
	}
	/* element classes used by the diagrams */
	.np-diagram :global(.box) {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
		rx: 6;
	}
	.np-diagram :global(.box-accent) {
		fill: var(--sl-color-accent-low);
		stroke: var(--sl-color-accent);
		stroke-width: 1.4;
		rx: 6;
	}
	.np-diagram :global(.box-soft) {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
		stroke-dasharray: 4 3;
		rx: 8;
	}
	.np-diagram :global(.t) {
		fill: var(--sl-color-white);
		font-size: 13px;
	}
	.np-diagram :global(.t-sm) {
		fill: var(--sl-color-gray-2);
		font-size: 11px;
	}
	.np-diagram :global(.t-muted) {
		fill: var(--sl-color-gray-3);
		font-size: 11px;
	}
	.np-diagram :global(.t-accent) {
		fill: var(--sl-color-accent-high);
		font-size: 12px;
		font-weight: 600;
	}
	.np-diagram :global(.t-head) {
		fill: var(--sl-color-white);
		font-size: 14px;
		font-weight: 600;
	}
	.np-diagram :global(.edge) {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.3;
		fill: none;
	}
	.np-diagram :global(.edge-accent) {
		stroke: var(--sl-color-accent);
		stroke-width: 1.6;
		fill: none;
	}
</style>
