# Example .env for the production stack in this directory.
#
# In CI/CD you do NOT create this file by hand: the deploy workflow renders
# .env on the server from GitHub repo Variables and Secrets (see README.md).
# This file documents every knob and lets you run the stack manually:
#
#   cp .env.example .env && docker compose up -d
#
# ---------------------------------------------------------------------------

# Container image to run. The deploy pipeline pins an immutable per-commit
# tag (ghcr.io/myfoxit/northplane:main-<sha>); :latest is fine for manual use.
NORTHPLANE_IMAGE=ghcr.io/myfoxit/northplane:latest

# Public hostname Caddy obtains a Let's Encrypt certificate for. Requires a
# DNS A-record pointing at this host. Use "localhost" for a pure local trial.
DOMAIN=doktrace.com

# Bare-IP fallback endpoint (self-signed). Reachable before DNS is live.
SERVER_IP=178.104.12.226

# ACME account email (Let's Encrypt notifications).
ACME_EMAIL=admin@doktrace.com

# External base URL the app uses for links / ack URLs / OIDC redirects.
NORTHPLANE_BASE_URL=https://doktrace.com

# ----- demo / real data switch ---------------------------------------------
# true  → seed the idempotent showcase environment (demo-* hosts, services,
#         alerts, dashboard, BPI tree, demo users).
# false → clean install: create the admin via /setup (or the break-glass
#         admin below) and add your real hosts.
#
# The two modes use SEPARATE data directories (below), so flipping the switch
# never mixes demo and real data — and the app refuses to seed demo data on
# top of a database that already holds real, non-demo hosts.
NORTHPLANE_DEMO=true
# demo mode → /var/lib/northplane/demo   •   real mode → /var/lib/northplane/real
NORTHPLANE_DATA_DIR=/var/lib/northplane/demo

# ----- break-glass admin (created on first start only, if absent) ----------
# Set a strong password via a GitHub Secret in CI. Leave PASSWORD empty to
# disable seeding and use the interactive /setup page instead.
NP_DEFAULT_ADMIN_EMAIL=admin@doktrace.com
NP_DEFAULT_ADMIN_PASSWORD=change-me
