# openapi-typescript (typed-codegen pipeline, `make types`) still declares a
# peer of typescript@^5.x, but this project runs typescript@~6.0.2 (TS 6 is a
# drop-in for the codegen's emit). The peer range is stale upstream metadata,
# not a real incompatibility, so we relax peer-dep resolution rather than pin
# the toolchain back. Re-evaluate once openapi-typescript widens its peer range.
legacy-peer-deps=true
